# Copy this file to "keystore.properties" (same folder) and fill in your own values.
# keystore.properties and the keystore itself must NEVER be committed (both are in .gitignore).
# Keep a backup of the keystore and its passwords: without them, no update of the app
# can be installed over the version already on the phones.
storeFile=C:/Users/YourName/Keys/batc-remote-release.jks
storePassword=change-me
keyAlias=batcremote
keyPassword=change-me
